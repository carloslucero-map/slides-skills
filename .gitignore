# macOS
.DS_Store
.AppleDouble
._*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Editors
.vscode/
.idea/
*.swp

# Skill build output — decks and verification artefacts are per-engagement,
# never committed. The skills are the source; the decks they produce are not.
*.html
!wpp-es-html-deck/assets/snippets/**/*.html
# Canon templates are source, not output — they are the whole point of canon/.
!wpp-es-html-deck/canon/**/*.html
screenshots/
shots/
contact-sheet.png
*.slide-*.png

# Generated by scripts/build_docs.py from references/sections/.
wpp-es-html-deck/build/

# Upload bundle, rebuilt on demand by wpp-es-html-deck/scripts/package_skill.py.
# Repo root on purpose: inside the skill it would count against the 30 MB cap.
/dist/
